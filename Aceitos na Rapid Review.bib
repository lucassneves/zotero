@inproceedings{suk-ieam_smartwatch-based_2025,
	title = {Smartwatch-Based {IMU} Analysis of Motor Tasks for Parkinson's Disease Screening},
	url = {https://ieeexplore.ieee.org/abstract/document/11478101},
	doi = {10.1109/i-CREATe67590.2025.11478101},
	abstract = {Parkinson's disease is a common neurodegenerative disorder where early diagnosis remains a significant challenge. The trends of wearable devices, like smartwatches with {IMU} sensors, show potential for accessible and low-cost screening. This study aims to determine whether data from a single simple motor task collected from a consumer smartwatch can be used to classify Parkinson's disease. We utilized the Parkinson's Disease Smartwatch ({PADS}) dataset, which contains {IMU} data from Parkinson's disease and Healthy Control participants performing 11 motor tasks. The data for each task was analyzed separately. Both traditional machine learning models ({SVM} and {XGBoost}) on extracted statistical features and deep learning models (1D {CNN} and {CNN}-{LSTM}) on raw time-series data were evaluated. To address the class imbalance, the minority class (Healthy Control) was up-sampled. Our findings showed that high performance can be achieved from a single task. The {CNN} model yielded the highest accuracy of 87.32\% on the “Finger-to-Finger” task. Traditional models also showed strong performance, especially {XGBoost}. {XGBoost} model achieved an accuracy of 84.51\% on the “Finger-to-Nose” task. We demonstrate that a single simple motor task can serve as an effective and accurate screening method for Parkinson's disease based on the sensors from a consumer-grade smartwatch. This made at-home {PD} screening possible, which can lead to earlier detection for Parkinson's disease patients.},
	eventtitle = {2025 18th International Convention on Rehabilitation Engineering and Assistive Technology (i-{CREATe})},
