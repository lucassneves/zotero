@inproceedings{sridhar_early_2026,
	title = {Early Detection and Differential Diagnosis of a Progressive Neurodegenerative Disorder Using Wearable Sensor Data and Machine Learning},
	volume = {1},
	url = {https://ieeexplore.ieee.org/abstract/document/11736498},
	doi = {10.1109/ICONICA70605.2026.11736498},
	abstract = {Neurodegenerative diseases like Parkinson’s disease ({PD}) tend to only be diagnosed at the end of the neuronal destruction, when there is significant loss. This highlights the importance of low cost, objective, real-time monitoring systems that are able to identify early motor changes. For this, wearable inertial sensors (accelerometers, gyroscopes, and magnetometers) allow real world movement data to be collected without the need for invasive sensors. This work introduces a dual-path system architecture along with a machine-learning pipeline to detect {PD} using resting tremor, bradykinesia, rigidity, and gait/postural instability. Time domain, frequency domain and statistical features of tri-axial accelerometer and gyroscope signals obtained from a public database containing healthy controls, {PD} patients and differential-di-agnosis cases (essential tremor, {ET}) were extracted. Two classifiers, {SVM} and Random Forest and Gradient Boosting were used as classical classifiers and compared with a hybrid {CNN}-{BiLSTM} network with temporal attention that was used for stratified 10-fold and leave-one-subject-out validation. Results indicate that wearable-sensor pipelines are evolving for remote screening, and that distinguishing {PD} from other similar disorders is still difficult, which will be the motivation for multimodal longitudinal wearable monitoring.},
	eventtitle = {2026 International Conference on Next-Gen Intelligent Computing and Applications ({ICONICA})},
