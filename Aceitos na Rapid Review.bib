@inproceedings{pathirathna_neurolens_2026,
	title = {{NeuroLens}: A Multimodal Mobile Platform for Early Parkinson's Disease Screening Using {TinyML} and Cross-Modal Feature Fusion},
	issn = {2995-2859},
	url = {https://ieeexplore.ieee.org/document/11600138},
	doi = {10.1109/I2CACIS69435.2026.11600138},
	shorttitle = {{NeuroLens}},
	abstract = {Early Parkinson's Disease ({PD}) screening remains constrained by specialist dependency and subjective assessments. This paper presents {NeuroLens}, a cross-platform mobile application integrating four digital biomarker streams handwriting kinematics, voice acoustics, wearable tremor quantification, and cognitive assessment fused into a unified risk score. The system couples a React Native client with a Python {FastAPI} backend, Google Firestore, and a Bluetooth Low Energy ({BLE}) wearable running a quantized 1D Convolutional Neural Network ({CNN}) via {TinyML}. Kinematic features are extracted from digitized spiral and wave drawing tasks (60 Hz, Gaussian-smoothed); voice analysis employs a dual-path acoustic-linguistic pipeline; and cognitive function is assessed via digitized Trail Making Test Part A ({TMT}-A) and Symbol Digit Modalities Test ({SDMT}). Individual modules were validated on separate datasets drawing (n=58), cognitive (n=4,267 {PPMI}), wearable ({PhysioNet} {PADS}), and voice ({UCI} {PD} speech corpus) and the fused score is presented as a proof-of-concept requiring prospective unified validation. The platform additionally supports multilingual localization and longitudinal history tracking.},
